{
  "buildCommand": "prisma generate && prisma db push --skip-generate && npm run build",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": "build/client",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/nightly-export",
      "schedule": "0 2 * * *"
    }
  ]
}
